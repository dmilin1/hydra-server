# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_character_hex_encryption_key_here
DASHBOARD_PASSWORD=your_secure_dashboard_password

IS_CUSTOM_SERVER=true
AI_PROVIDER=openai

# OpenCode Go's OpenAI-compatible API
OPENAI_API_KEY=your_opencode_go_api_key
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_SUMMARY_MODEL=gpt-6-luna
OPENAI_QUERY_MODEL=gpt-6-luna
OPENAI_FILTER_MODEL=gpt-6-luna

# Local embeddings via the optional Ollama Compose service (start with
# `docker compose --profile embeddings up -d`). Ollama ignores this API key.
OPENAI_EMBEDDING_API_KEY=ollama
OPENAI_EMBEDDING_BASE_URL=http://ollama:11434/v1
OPENAI_EMBEDDING_MODEL=nomic-embed-text
